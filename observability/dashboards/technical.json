{
  "uid": "technical",
  "title": "Marketplace · Technical",
  "schemaVersion": 39,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total[30s]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p95 · seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(http_request_duration_seconds_bucket[30s])))"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP errors / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(errors_total[30s]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "CPU · cores",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job)(rate(process_cpu_seconds_total[30s]))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Resident memory · bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job)(process_resident_memory_bytes)"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_requests_total)"
        }
      ]
    }
  ]
}
